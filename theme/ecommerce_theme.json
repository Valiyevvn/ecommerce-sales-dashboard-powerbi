{
  "name": "Ecommerce Executive",
  "dataColors": ["#13A89E", "#3E7CB1", "#0B2545", "#E4572E", "#F2B134", "#7A8B99", "#8E6BBF", "#5FB3D9"],
  "background": "#FFFFFF",
  "foreground": "#0B2545",
  "tableAccent": "#13A89E",
  "good": "#13A89E",
  "neutral": "#F2B134",
  "bad": "#E4572E",
  "maximum": "#13A89E",
  "center": "#F2B134",
  "minimum": "#E4572E",
  "textClasses": {
    "label": { "fontSize": 10, "fontFace": "Segoe UI", "color": "#5C6B7A" },
    "callout": { "fontSize": 28, "fontFace": "Segoe UI Semibold", "color": "#0B2545" },
    "title": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#0B2545" },
    "header": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#0B2545" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F4F6F9" } }, "transparency": 0 }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E1E6EC" } }, "radius": 8 }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#0B2545" } }, "fontSize": 12, "fontFamily": "Segoe UI Semibold" }]
      }
    }
  }
}
